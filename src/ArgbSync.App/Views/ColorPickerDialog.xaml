<Window x:Class="ArgbSync.App.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArgbSync.App.Controls"
        Title="Cor do LED"
        Width="280"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF141419">
    <StackPanel Margin="16">
        <TextBlock Text="Escolha a cor deste LED"
                   Margin="0,0,0,10"
                   Foreground="#FFE8E8EE" />
        <controls:ColorPickerControl x:Name="Picker" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancelar"
                    IsCancel="True"
                    Margin="0,0,8,0"
                    MinWidth="90" />
            <Button x:Name="OkButton"
                    Content="OK"
                    IsDefault="True"
                    MinWidth="90"
                    Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>