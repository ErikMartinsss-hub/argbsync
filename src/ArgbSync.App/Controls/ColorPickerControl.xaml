<UserControl x:Class="ArgbSync.App.Controls.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border x:Name="Preview"
                Background="#FF333333"
                BorderBrush="#FF555555"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,0,0,10">
            <TextBlock Text="Pré-visualização"
                       Foreground="#FF9A9AA8"
                       HorizontalAlignment="Center" />
        </Border>

        <Grid Margin="0,2,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="R" Foreground="#FFFF6B6B" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="G" Foreground="#FF6BFF8C" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="B" Foreground="#FF4CC3FF" VerticalAlignment="Center" />

            <Slider x:Name="RedSlider"
                    Grid.Row="0" Grid.Column="1"
                    Minimum="0" Maximum="255"
                    ValueChanged="OnChannelChanged"
                    Margin="6,2" />
            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="{Binding Value, ElementName=RedSlider, StringFormat={}{0:0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />

            <Slider x:Name="GreenSlider"
                    Grid.Row="1" Grid.Column="1"
                    Minimum="0" Maximum="255"
                    ValueChanged="OnChannelChanged"
                    Margin="6,2" />
            <TextBlock Grid.Row="1" Grid.Column="2"
                       Text="{Binding Value, ElementName=GreenSlider, StringFormat={}{0:0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />

            <Slider x:Name="BlueSlider"
                    Grid.Row="2" Grid.Column="1"
                    Minimum="0" Maximum="255"
                    ValueChanged="OnChannelChanged"
                    Margin="6,2" />
            <TextBlock Grid.Row="2" Grid.Column="2"
                       Text="{Binding Value, ElementName=BlueSlider, StringFormat={}{0:0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Grid Margin="0,2,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hex" VerticalAlignment="Center" />
            <TextBox x:Name="HexBox"
                     Grid.Column="1"
                     Text="FFFFFF"
                     MaxLength="7"
                     TextChanged="OnHexChanged"
                     HorizontalContentAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>